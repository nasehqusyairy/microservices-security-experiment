# Defaults for local execution. run-local-demo-2.js reads this file directly;
# Docker Compose can use it with --env-file .env.example.
JWT_SECRET=local-development-jwt-secret
ORDER_SERVICE_SECRET=local-development-order-secret
NODE_ENV=development
ALLOWED_CLIENT_CNS=gateway-client

MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mse
MYSQL_USER=mse_runner
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=5000

REDIS_URL=redis://127.0.0.1:6379
EXPERIMENT_MODE_PRESET=quick
EXPERIMENT_TOKEN_TTL_SECONDS=300
EXPERIMENT_OUTPUT_DIR=./results
CERTS_DIR=./certs
